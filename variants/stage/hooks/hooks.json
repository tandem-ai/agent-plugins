{
  "description": "Tandem: announce the linked project at session start; keep a session from ending unsynced when the workspace asked for automatic sync.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/stop-sync-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
